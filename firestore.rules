rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Leftover PIN copies. Keep the documents; do not leave them world-open.
    match /users/{accessCode} {
      allow read, write: if false;
      match /{allPaths=**} {
        allow read, write: if false;
      }
    }
    
    // Product-agnostic org + invite list (Phase 1 B).
    match /organizations/{orgId} {
      function signedIn() {
        return request.auth != null
          && request.auth.token.email is string
          && request.auth.token.email.size() > 0;
      }

      function emailLower() {
        return request.auth.token.email.lower();
      }

      function isInvited() {
        return signedIn() && emailLower() in resource.data.invitedEmails;
      }

      allow read: if isInvited();
      allow create, delete: if false;
      allow update: if isInvited()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['legacyWorkspaceNames', 'invitedEmails', 'updatedAt', 'assistantWritesEnabled'])
        && request.resource.data.ownerEmail.lower() in request.resource.data.invitedEmails
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['invitedEmails'])
          || emailLower() == resource.data.ownerEmail.lower()
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assistantWritesEnabled'])
          || (
            emailLower() == resource.data.ownerEmail.lower()
            && request.resource.data.assistantWritesEnabled is bool
          )
        );

      match /projects/{projectId} {
        function orgDoc() {
          return get(/databases/$(database)/documents/organizations/$(orgId));
        }

        function isOrgOwner() {
          return signedIn() && emailLower() == orgDoc().data.ownerEmail.lower();
        }

        function isProjectMember() {
          return signedIn() && emailLower() in resource.data.invitedEmails;
        }

        function canUseProject() {
          return signedIn()
            && emailLower() in get(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)).data.invitedEmails;
        }

        function ownerStaysOnJob() {
          return orgDoc().data.ownerEmail.lower() in request.resource.data.invitedEmails;
        }

        function statusOk() {
          return !request.resource.data.keys().hasAny(['status'])
            || request.resource.data.status in ['active', 'archived'];
        }

        allow read: if isProjectMember();
        allow create: if isOrgOwner()
          && request.resource.data.orgId == orgId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.status == 'active'
          && request.resource.data.invitedEmails is list
          && emailLower() in request.resource.data.invitedEmails
          && orgDoc().data.ownerEmail.lower() in request.resource.data.invitedEmails
          && (
            !request.resource.data.keys().hasAny(['kind'])
            || request.resource.data.kind in ['client', 'own']
          )
          && !request.resource.data.keys().hasAny(['legacyWorkspaceId', 'accessCode']);
        allow update: if isProjectMember()
          && ownerStaysOnJob()
          && statusOk()
          && (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'updatedAt', 'budget', 'kind'])
            || (
              isOrgOwner()
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['name', 'invitedEmails', 'formerEmails', 'status', 'archivedAt', 'archivedBy', 'updatedAt', 'budget', 'kind'])
            )
          );
        allow delete: if false;

        function expenseOk() {
          return (
            !request.resource.data.keys().hasAny(['category'])
            || request.resource.data.category is string
          ) && (
            !request.resource.data.keys().hasAny(['tradeId'])
            || request.resource.data.tradeId == null
            || (
              request.resource.data.tradeId is string
              && request.resource.data.tradeId.size() > 0
              && request.resource.data.tradeId.size() <= 80
            )
          ) && (
            !request.resource.data.keys().hasAny(['partyId'])
            || request.resource.data.partyId == null
            || (
              request.resource.data.partyId is string
              && request.resource.data.partyId.size() > 0
              && request.resource.data.partyId.size() <= 80
            )
          ) && (
            !request.resource.data.keys().hasAny(['source'])
            || request.resource.data.source == 'assistant'
          ) && (
            !request.resource.data.keys().hasAny(['assistantReceiptId'])
            || (
              request.resource.data.assistantReceiptId is string
              && request.resource.data.assistantReceiptId.size() > 0
              && request.resource.data.assistantReceiptId.size() <= 128
            )
          ) && (
            !request.resource.data.keys().hasAny(['gstCents'])
            || (
              request.resource.data.gstCents is int
              && request.resource.data.gstCents >= 0
            )
          ) && (
            !request.resource.data.keys().hasAny(['assistantConfirmed'])
            || request.resource.data.assistantConfirmed is bool
          );
        }

        function invoiceOk() {
          return request.resource.data.invoiceNumber is string
            && (
              !request.resource.data.keys().hasAny(['status'])
              || request.resource.data.status in ['draft', 'sent', 'paid', 'overdue', 'void', 'pending', 'unpaid']
            )
            && (
              !request.resource.data.keys().hasAny(['partyId'])
              || request.resource.data.partyId == null
              || (
                request.resource.data.partyId is string
                && request.resource.data.partyId.size() > 0
                && request.resource.data.partyId.size() <= 80
              )
            );
        }

        match /expenses/{itemId} {
          allow read: if canUseProject();
          allow create, update: if canUseProject() && expenseOk();
          allow delete: if canUseProject()
            && resource.data.keys().hasAny(['status'])
            && resource.data.status == 'void';
        }
        match /invoices/{itemId} {
          allow read: if canUseProject();
          allow create, update: if canUseProject() && invoiceOk();
          allow delete: if canUseProject()
            && resource.data.keys().hasAny(['status'])
            && resource.data.status == 'void';
        }
        match /hiaContracts/{itemId} {
          allow read: if canUseProject();
          allow create, update: if canUseProject();
          allow delete: if false;
        }
        match /progressPayments/{itemId} {
          allow read: if canUseProject();
          allow create, update: if canUseProject();
          allow delete: if false;
        }
        match /labour/{itemId} {
          allow read: if canUseProject();
          allow create, update: if canUseProject();
          allow delete: if false;
        }
        match /trades/{itemId} {
          allow read: if canUseProject();
          allow create, update: if canUseProject();
          allow delete: if false;
        }
        match /clients/{itemId} {
          allow read: if canUseProject();
          allow create, update: if canUseProject();
          allow delete: if false;
        }
        match /suppliers/{itemId} {
          allow read: if canUseProject();
          allow create, update: if canUseProject();
          allow delete: if false;
        }
        match /serviceProviders/{itemId} {
          allow read: if canUseProject();
          allow create, update: if canUseProject();
          allow delete: if false;
        }
        match /payers/{itemId} {
          allow read: if canUseProject();
          allow create, update: if canUseProject();
          allow delete: if false;
        }
        match /bankDetails/{itemId} {
          allow read: if canUseProject();
          allow create, update: if canUseProject();
          allow delete: if false;
        }
        match /costPlan/{planId} {
          function costPlanKeysOk() {
            return request.resource.data.keys().hasAll([
                'jobId', 'level', 'targetCents', 'baselineDate', 'gstMode',
                'status', 'sections', 'createdBy', 'createdAt', 'updatedAt',
                'archivedAt'
              ])
              && request.resource.data.keys().hasOnly([
                'jobId', 'level', 'targetCents', 'baselineDate', 'gstMode',
                'status', 'sections', 'sourceFileId', 'createdBy', 'createdAt',
                'updatedAt', 'archivedAt'
              ]);
          }

          // targetCents must be a positive integer at every level. Firestore
          // rules cannot sum a list, so trades/imported also rely on the client
          // writing sections that add up to targetCents.
          function costPlanShapeOk() {
            return planId == 'current'
              && costPlanKeysOk()
              && request.resource.data.jobId == projectId
              && request.resource.data.level in ['target', 'trades', 'imported']
              && request.resource.data.targetCents is int
              && request.resource.data.targetCents > 0
              && request.resource.data.baselineDate is string
              && request.resource.data.baselineDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
              && request.resource.data.gstMode in ['inclusive', 'exclusive']
              && request.resource.data.status in ['draft', 'locked', 'archived']
              && request.resource.data.sections is list
              && request.resource.data.sections.size() <= 120
              && (
                (
                  request.resource.data.level == 'target'
                  && request.resource.data.sections.size() == 0
                )
                || (
                  request.resource.data.level in ['trades', 'imported']
                  && request.resource.data.sections.size() > 0
                )
              )
              && (
                !request.resource.data.keys().hasAny(['sourceFileId'])
                || request.resource.data.sourceFileId == null
                || request.resource.data.sourceFileId is string
              )
              && request.resource.data.createdBy is string
              && request.resource.data.createdBy.size() > 0
              && request.resource.data.createdAt is timestamp
              && request.resource.data.updatedAt is timestamp
              && (
                (request.resource.data.status == 'archived'
                  && request.resource.data.archivedAt is timestamp)
                || (request.resource.data.status != 'archived'
                  && request.resource.data.archivedAt == null)
              );
          }

          function costPlanIdentityOk() {
            return request.resource.data.createdBy == resource.data.createdBy
              && request.resource.data.createdAt == resource.data.createdAt
              && request.resource.data.jobId == resource.data.jobId;
          }

          function costPlanDraftContentKeys() {
            return request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['targetCents', 'baselineDate', 'gstMode', 'updatedAt', 'level', 'sections', 'sourceFileId']);
          }

          allow read: if canUseProject();
          allow create: if canUseProject()
            && costPlanShapeOk()
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.status == 'draft'
            && request.resource.data.level == 'target'
            && request.resource.data.sections.size() == 0;
          allow update: if canUseProject()
            && costPlanShapeOk()
            && costPlanIdentityOk()
            && (
              (
                resource.data.status == 'draft'
                && request.resource.data.status == 'draft'
                && costPlanDraftContentKeys()
              )
              || (
                resource.data.status == 'draft'
                && request.resource.data.status == 'locked'
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['status', 'updatedAt'])
              )
              || (
                resource.data.status in ['draft', 'locked']
                && request.resource.data.status == 'archived'
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['status', 'archivedAt', 'updatedAt'])
              )
              || (
                resource.data.status == 'archived'
                && request.resource.data.status == 'draft'
                && request.resource.data.archivedAt == null
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly([
                    'level', 'targetCents', 'baselineDate', 'gstMode', 'status',
                    'sections', 'sourceFileId', 'updatedAt', 'archivedAt'
                  ])
              )
            );
          allow delete: if false;
        }
        // Phase 16 Part A. Optional typed facts. Schema in the repo; not deployed.
        match /facts/{factId} {
          function factsKeysOk() {
            return request.resource.data.keys().hasAll([
                'jobId', 'schemaVersion', 'updatedAt'
              ])
              && request.resource.data.keys().hasOnly([
                'jobId', 'schemaVersion', 'updatedAt', 'createdAt', 'createdBy',
                'address', 'suburb', 'postcode', 'lotDp', 'council', 'zoning',
                'floorArea', 'siteArea', 'storeys', 'bedrooms', 'bathrooms',
                'garageSpaces', 'buildType',
                'contractValueCents', 'contractType', 'depositCents',
                'retentionPercent',
                'contractSigned', 'siteStart',
                'practicalCompletionTarget', 'practicalCompletionActual',
                'builderLicence', 'hbcfCertificate', 'cdcOrDaNumber', 'certifier'
              ]);
          }

          function factMetaOk(field) {
            return field is map
              && field.source in ['owner', 'import', 'document', 'assistant']
              && (
                field.sourceRef == null
                || (
                  field.sourceRef is string
                  && field.sourceRef.size() > 0
                  && field.sourceRef.size() <= 80
                )
              )
              && (
                field.confirmedBy == null
                || (
                  field.confirmedBy is string
                  && field.confirmedBy.size() > 0
                  && field.confirmedBy.size() <= 128
                )
              )
              && (field.confirmedAt == null || field.confirmedAt is timestamp)
              && field.updatedAt is timestamp
              && (
                !field.keys().hasAny(['previous'])
                || (
                  field.previous is list
                  && field.previous.size() <= 20
                )
              );
          }

          function stringFactOk(field) {
            return factMetaOk(field)
              && field.keys().hasAll([
                'value', 'source', 'sourceRef', 'confirmedBy', 'confirmedAt', 'updatedAt'
              ])
              && field.keys().hasOnly([
                'value', 'source', 'sourceRef', 'confirmedBy', 'confirmedAt',
                'updatedAt', 'previous'
              ])
              && field.value is string
              && field.value.size() > 0
              && field.value.size() <= 200;
          }

          function areaFactOk(field) {
            return factMetaOk(field)
              && field.keys().hasAll([
                'value', 'unit', 'source', 'sourceRef', 'confirmedBy',
                'confirmedAt', 'updatedAt'
              ])
              && field.keys().hasOnly([
                'value', 'unit', 'source', 'sourceRef', 'confirmedBy',
                'confirmedAt', 'updatedAt', 'previous'
              ])
              && field.unit == 'sqm'
              && (field.value is int || field.value is float)
              && field.value >= 0;
          }

          function centsFactOk(field) {
            return factMetaOk(field)
              && field.keys().hasAll([
                'value', 'source', 'sourceRef', 'confirmedBy', 'confirmedAt', 'updatedAt'
              ])
              && field.keys().hasOnly([
                'value', 'source', 'sourceRef', 'confirmedBy', 'confirmedAt',
                'updatedAt', 'previous'
              ])
              && field.value is int
              && field.value >= 0;
          }

          function percentFactOk(field) {
            return factMetaOk(field)
              && field.keys().hasAll([
                'value', 'source', 'sourceRef', 'confirmedBy', 'confirmedAt', 'updatedAt'
              ])
              && field.keys().hasOnly([
                'value', 'source', 'sourceRef', 'confirmedBy', 'confirmedAt',
                'updatedAt', 'previous'
              ])
              && (field.value is int || field.value is float)
              && field.value >= 0
              && field.value <= 100;
          }

          function dateFactOk(field) {
            return factMetaOk(field)
              && field.keys().hasAll([
                'value', 'source', 'sourceRef', 'confirmedBy', 'confirmedAt', 'updatedAt'
              ])
              && field.keys().hasOnly([
                'value', 'source', 'sourceRef', 'confirmedBy', 'confirmedAt',
                'updatedAt', 'previous'
              ])
              && field.value is string
              && field.value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
          }

          function factsFieldsOk() {
            return (
                !request.resource.data.keys().hasAny(['address'])
                || stringFactOk(request.resource.data.address)
              )
              && (
                !request.resource.data.keys().hasAny(['suburb'])
                || stringFactOk(request.resource.data.suburb)
              )
              && (
                !request.resource.data.keys().hasAny(['postcode'])
                || stringFactOk(request.resource.data.postcode)
              )
              && (
                !request.resource.data.keys().hasAny(['lotDp'])
                || stringFactOk(request.resource.data.lotDp)
              )
              && (
                !request.resource.data.keys().hasAny(['council'])
                || stringFactOk(request.resource.data.council)
              )
              && (
                !request.resource.data.keys().hasAny(['zoning'])
                || stringFactOk(request.resource.data.zoning)
              )
              && (
                !request.resource.data.keys().hasAny(['buildType'])
                || stringFactOk(request.resource.data.buildType)
              )
              && (
                !request.resource.data.keys().hasAny(['contractType'])
                || stringFactOk(request.resource.data.contractType)
              )
              && (
                !request.resource.data.keys().hasAny(['builderLicence'])
                || stringFactOk(request.resource.data.builderLicence)
              )
              && (
                !request.resource.data.keys().hasAny(['hbcfCertificate'])
                || stringFactOk(request.resource.data.hbcfCertificate)
              )
              && (
                !request.resource.data.keys().hasAny(['cdcOrDaNumber'])
                || stringFactOk(request.resource.data.cdcOrDaNumber)
              )
              && (
                !request.resource.data.keys().hasAny(['certifier'])
                || stringFactOk(request.resource.data.certifier)
              )
              && (
                !request.resource.data.keys().hasAny(['floorArea'])
                || areaFactOk(request.resource.data.floorArea)
              )
              && (
                !request.resource.data.keys().hasAny(['siteArea'])
                || areaFactOk(request.resource.data.siteArea)
              )
              && (
                !request.resource.data.keys().hasAny(['storeys'])
                || centsFactOk(request.resource.data.storeys)
              )
              && (
                !request.resource.data.keys().hasAny(['bedrooms'])
                || centsFactOk(request.resource.data.bedrooms)
              )
              && (
                !request.resource.data.keys().hasAny(['bathrooms'])
                || centsFactOk(request.resource.data.bathrooms)
              )
              && (
                !request.resource.data.keys().hasAny(['garageSpaces'])
                || centsFactOk(request.resource.data.garageSpaces)
              )
              && (
                !request.resource.data.keys().hasAny(['contractValueCents'])
                || centsFactOk(request.resource.data.contractValueCents)
              )
              && (
                !request.resource.data.keys().hasAny(['depositCents'])
                || centsFactOk(request.resource.data.depositCents)
              )
              && (
                !request.resource.data.keys().hasAny(['retentionPercent'])
                || percentFactOk(request.resource.data.retentionPercent)
              )
              && (
                !request.resource.data.keys().hasAny(['contractSigned'])
                || dateFactOk(request.resource.data.contractSigned)
              )
              && (
                !request.resource.data.keys().hasAny(['siteStart'])
                || dateFactOk(request.resource.data.siteStart)
              )
              && (
                !request.resource.data.keys().hasAny(['practicalCompletionTarget'])
                || dateFactOk(request.resource.data.practicalCompletionTarget)
              )
              && (
                !request.resource.data.keys().hasAny(['practicalCompletionActual'])
                || dateFactOk(request.resource.data.practicalCompletionActual)
              );
          }

          function factsShapeOk() {
            return factId == 'current'
              && factsKeysOk()
              && request.resource.data.jobId == projectId
              && request.resource.data.schemaVersion == 1
              && request.resource.data.updatedAt is timestamp
              && (
                !request.resource.data.keys().hasAny(['createdAt'])
                || request.resource.data.createdAt is timestamp
              )
              && (
                !request.resource.data.keys().hasAny(['createdBy'])
                || (
                  request.resource.data.createdBy is string
                  && request.resource.data.createdBy.size() > 0
                  && request.resource.data.createdBy.size() <= 128
                )
              )
              && factsFieldsOk();
          }

          function factsIdentityOk() {
            return request.resource.data.jobId == resource.data.jobId
              && request.resource.data.schemaVersion == resource.data.schemaVersion
              && (
                (
                  !resource.data.keys().hasAny(['createdBy'])
                  && !request.resource.data.keys().hasAny(['createdBy'])
                )
                || request.resource.data.createdBy == resource.data.createdBy
              )
              && (
                (
                  !resource.data.keys().hasAny(['createdAt'])
                  && !request.resource.data.keys().hasAny(['createdAt'])
                )
                || request.resource.data.createdAt == resource.data.createdAt
              );
          }

          allow read: if canUseProject();
          allow create: if canUseProject()
            && factsShapeOk()
            && (
              !request.resource.data.keys().hasAny(['createdBy'])
              || request.resource.data.createdBy == request.auth.uid
            );
          allow update: if canUseProject()
            && factsShapeOk()
            && factsIdentityOk();
          allow delete: if false;
        }
        match /quotes/{itemId} {
          function quoteOk() {
            // Allocations must cover amountCents in the client. Rules cannot
            // sum a list of maps, same limit as cost-plan sections vs targetCents.
            return request.resource.data.keys().hasAll([
                'jobId', 'party', 'receivedDate', 'status', 'amountCents',
                'gstMode', 'allocations', 'createdBy', 'createdAt', 'updatedAt'
              ])
              && request.resource.data.jobId == projectId
              && request.resource.data.party is string
              && request.resource.data.party.size() > 0
              && request.resource.data.party.size() <= 120
              && request.resource.data.receivedDate is string
              && request.resource.data.receivedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
              && request.resource.data.status in ['received', 'chosen', 'passed', 'void']
              && request.resource.data.amountCents is int
              && request.resource.data.amountCents > 0
              && (
                !request.resource.data.keys().hasAny(['amountHighCents'])
                || request.resource.data.amountHighCents == null
                || (
                  request.resource.data.amountHighCents is int
                  && request.resource.data.amountHighCents >= request.resource.data.amountCents
                )
              )
              && request.resource.data.gstMode in ['inclusive', 'exclusive']
              && request.resource.data.allocations is list
              && request.resource.data.allocations.size() > 0
              && request.resource.data.allocations.size() <= 20
              && request.resource.data.createdBy is string
              && request.resource.data.createdBy.size() > 0
              && request.resource.data.createdAt is timestamp
              && request.resource.data.updatedAt is timestamp
              && (
                !request.resource.data.keys().hasAny(['fileId'])
                || request.resource.data.fileId == null
                || (
                  request.resource.data.fileId is string
                  && request.resource.data.fileId.size() > 0
                  && request.resource.data.fileId.size() <= 80
                )
              )
              && (
                !request.resource.data.keys().hasAny(['fileIds'])
                || (
                  request.resource.data.fileIds is list
                  && request.resource.data.fileIds.size() <= 10
                )
              )
              && (
                request.resource.data.status != 'void'
                || request.resource.data.voidedAt is timestamp
              )
              && (
                !request.resource.data.keys().hasAny(['partyId'])
                || request.resource.data.partyId == null
                || (
                  request.resource.data.partyId is string
                  && request.resource.data.partyId.size() > 0
                  && request.resource.data.partyId.size() <= 80
                )
              );
          }

          allow read: if canUseProject();
          allow create: if canUseProject()
            && quoteOk()
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.status in ['received', 'chosen', 'passed'];
          allow update: if canUseProject()
            && quoteOk()
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.jobId == resource.data.jobId;
          allow delete: if false;
        }
        match /files/{itemId} {
          function jobFileTypeOk() {
            return request.resource.data.type in [
              'contract', 'variation', 'plan', 'permit', 'certificate',
              'quote', 'estimate', 'photo', 'invoiceReceived', 'other'
            ];
          }

          function jobFileContentTypeOk() {
            return request.resource.data.contentType is string
              && !request.resource.data.contentType.matches('^video/.*')
              && request.resource.data.contentType in [
                'image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp',
                'image/heic', 'image/heif', 'image/tiff',
                'application/pdf',
                'application/msword',
                'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
                'application/vnd.ms-excel',
                'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
                'application/vnd.ms-powerpoint',
                'application/vnd.openxmlformats-officedocument.presentationml.presentation',
                'text/plain',
                'application/rtf',
                'application/acad',
                'image/vnd.dwg',
                'application/dxf',
                'application/x-dxf'
              ];
          }

          function jobFileLinkedToOk() {
            return !request.resource.data.keys().hasAny(['linkedTo'])
              || request.resource.data.linkedTo == null
              || (
                request.resource.data.linkedTo.keys().hasAll(['kind', 'id'])
                && request.resource.data.linkedTo.kind in ['expense', 'invoice', 'hiaContract']
                && request.resource.data.linkedTo.id is string
                && request.resource.data.linkedTo.id.size() > 0
              );
          }

          function jobFilePathOk() {
            return request.resource.data.storagePath is string
              && request.resource.data.storagePath.matches(
                '^files/' + orgId + '/' + projectId + '/' + itemId + '/.+'
              )
              && (
                !request.resource.data.keys().hasAny(['thumbnailPath'])
                || request.resource.data.thumbnailPath == null
                || (
                  request.resource.data.thumbnailPath is string
                  && request.resource.data.thumbnailPath.matches(
                    '^files/' + orgId + '/' + projectId + '/' + itemId + '/.+'
                  )
                )
              );
          }

          function jobFileOk() {
            return request.resource.data.name is string
              && request.resource.data.name.size() > 0
              && request.resource.data.name.size() <= 200
              && jobFileTypeOk()
              && jobFilePathOk()
              && jobFileContentTypeOk()
              && request.resource.data.sizeBytes is number
              && request.resource.data.sizeBytes >= 0
              && request.resource.data.sizeBytes <= 26214400
              && request.resource.data.uploadedBy is string
              && request.resource.data.uploadedBy.size() > 0
              && request.resource.data.documentDate is string
              && request.resource.data.documentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
              && (
                !request.resource.data.keys().hasAny(['note'])
                || request.resource.data.note is string
              )
              && request.resource.data.status in ['active', 'archived']
              && (
                request.resource.data.status == 'active'
                || request.resource.data.archivedAt is timestamp
              )
              && jobFileLinkedToOk();
          }

          allow read: if canUseProject();
          allow create: if canUseProject()
            && jobFileOk()
            && request.resource.data.uploadedBy == request.auth.uid
            && request.resource.data.status == 'active';
          allow update: if canUseProject()
            && jobFileOk()
            && request.resource.data.uploadedBy == resource.data.uploadedBy
            && request.resource.data.storagePath == resource.data.storagePath;
          allow delete: if false;

          // Extracted text is a sibling, not a field on the file list
          // document. Must stay inside this match — the project catch-all
          // below would deny it.
          match /content/{docId} {
            allow read: if canUseProject() && docId == 'text';
            allow create, update, delete: if false;
          }
        }
        match /ledgerRollup/{docId} {
          allow read: if canUseProject() && docId == 'current';
          allow create, update, delete: if false;
        }
        match /{allPaths=**} {
          allow read, write: if false;
        }
      }

      match /tradeList/{tradeId} {
        function isOrgInvited() {
          return signedIn()
            && emailLower() in get(/databases/$(database)/documents/organizations/$(orgId)).data.invitedEmails;
        }

        function tradeListOk() {
          return request.resource.data.keys().hasAll(['name', 'order', 'isAppDefault', 'status', 'createdAt', 'updatedAt'])
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 80
            && request.resource.data.order is int
            && request.resource.data.order >= 0
            && request.resource.data.isAppDefault is bool
            && request.resource.data.status in ['active', 'archived']
            && request.resource.data.createdAt is timestamp
            && request.resource.data.updatedAt is timestamp;
        }

        allow read: if signedIn();
        allow create: if isOrgInvited() && tradeListOk();
        allow update: if isOrgInvited()
          && tradeListOk()
          && request.resource.data.isAppDefault == resource.data.isAppDefault
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }

      match /parties/{partyId} {
        function isOrgInvited() {
          return signedIn()
            && emailLower() in get(/databases/$(database)/documents/organizations/$(orgId)).data.invitedEmails;
        }

        function partyOk() {
          return request.resource.data.keys().hasAll(['displayName', 'canonicalName', 'kind', 'status', 'createdAt', 'updatedAt'])
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && request.resource.data.displayName.size() <= 120
            && request.resource.data.canonicalName is string
            && request.resource.data.canonicalName.size() > 0
            && request.resource.data.canonicalName.size() <= 120
            && request.resource.data.kind in ['supplier', 'worker', 'trade', 'client', 'service provider']
            && request.resource.data.status in ['active', 'merged']
            && request.resource.data.createdAt is timestamp
            && request.resource.data.updatedAt is timestamp
            && (
              !request.resource.data.keys().hasAny(['abn'])
              || request.resource.data.abn == null
              || (
                request.resource.data.abn is string
                && request.resource.data.abn.size() <= 20
              )
            )
            && (
              !request.resource.data.keys().hasAny(['email'])
              || request.resource.data.email == null
              || (
                request.resource.data.email is string
                && request.resource.data.email.size() <= 120
              )
            )
            && (
              !request.resource.data.keys().hasAny(['phone'])
              || request.resource.data.phone == null
              || (
                request.resource.data.phone is string
                && request.resource.data.phone.size() <= 40
              )
            )
            && (
              (
                request.resource.data.status == 'active'
                && (
                  !request.resource.data.keys().hasAny(['mergedInto'])
                  || request.resource.data.mergedInto == null
                )
              )
              || (
                request.resource.data.status == 'merged'
                && request.resource.data.mergedInto is string
                && request.resource.data.mergedInto.size() > 0
                && request.resource.data.mergedInto.size() <= 80
                && request.resource.data.mergedInto != partyId
              )
            );
        }

        allow read: if isOrgInvited();
        allow create: if isOrgInvited() && partyOk();
        allow update: if isOrgInvited()
          && partyOk()
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }

      match /ledgerRollup/{docId} {
        function isOrgInvited() {
          return signedIn()
            && emailLower() in get(/databases/$(database)/documents/organizations/$(orgId)).data.invitedEmails;
        }

        allow read: if isOrgInvited() && docId == 'current';
        allow create, update, delete: if false;
      }

      // Phase 14 Part D. Per-user Ask questions. Not a chat log.
      // Path: organizations/{orgId}/askHistory/{uid}/items/{id}
      match /askHistory/{historyUid} {
        allow read, write: if false;

        match /items/{questionId} {
          function isOrgInvited() {
            return signedIn()
              && emailLower() in get(/databases/$(database)/documents/organizations/$(orgId)).data.invitedEmails;
          }

          function askQueryNameOk(name) {
            return name in [
              'spendByTrade', 'spendByParty', 'spendByCategory', 'planVsActual',
              'invoicesByStatus', 'jobSummary', 'portfolioSummary', 'findFiles',
              'findExpenses', 'quotesForTrade', 'answerFromDocuments', 'jobFacts', 'none'
            ];
          }

          function provenanceQueryOk(name) {
            return name in [
              'spendByTrade', 'spendByParty', 'spendByCategory', 'planVsActual',
              'invoicesByStatus', 'jobSummary', 'portfolioSummary', 'findFiles',
              'findExpenses', 'quotesForTrade', 'answerFromDocuments', 'jobFacts'
            ];
          }

          function askParamsOk(params) {
            return params.keys().hasOnly([
              'jobId', 'tradeId', 'trade', 'partyId', 'party', 'category',
              'status', 'type', 'text', 'from', 'to', 'period', 'olderThanDays', 'field'
            ]);
          }

          function intOrNull(value) {
            return value == null || value is int;
          }

          function snapshotOk(s) {
            return s == null || (
              s.keys().hasOnly([
                'cents', 'count', 'planCents', 'actualCents',
                'uncodedCents', 'uncodedCount', 'capped'
              ])
              && (!s.keys().hasAny(['cents']) || intOrNull(s.cents))
              && (!s.keys().hasAny(['count']) || intOrNull(s.count))
              && (!s.keys().hasAny(['planCents']) || intOrNull(s.planCents))
              && (!s.keys().hasAny(['actualCents']) || intOrNull(s.actualCents))
              && (!s.keys().hasAny(['uncodedCents']) || intOrNull(s.uncodedCents))
              && (!s.keys().hasAny(['uncodedCount']) || intOrNull(s.uncodedCount))
              && (!s.keys().hasAny(['capped']) || s.capped is bool)
            );
          }

          function provenanceOk(p) {
            return p == null || (
              p.keys().hasOnly(['query', 'params', 'source', 'revision', 'rowCount', 'capped'])
              && provenanceQueryOk(p.query)
              && p.source in ['rollup', 'ledger', 'files', 'mixed', 'facts']
              && p.rowCount is int
              && p.capped is bool
              && (!p.keys().hasAny(['revision']) || p.revision is int)
            );
          }

          function choiceOk(c) {
            return c.keys().hasOnly(['query', 'params', 'provenance', 'snapshot', 'refusalReason'])
              && askQueryNameOk(c.query)
              && askParamsOk(c.params)
              && (!c.keys().hasAny(['sentence', 'reason', 'messages', 'content', 'reply']))
              && (!c.keys().hasAny(['refusalReason']) || c.refusalReason in [
                'fact_missing', 'nothing_coded', 'unreadable_file', 'out_of_scope'
              ])
              && (!c.keys().hasAny(['provenance']) || provenanceOk(c.provenance))
              && (!c.keys().hasAny(['snapshot']) || snapshotOk(c.snapshot));
          }

          function choicesOk() {
            return request.resource.data.choices is list
              && request.resource.data.choices.size() >= 1
              && request.resource.data.choices.size() <= 3
              && choiceOk(request.resource.data.choices[0])
              && (
                request.resource.data.choices.size() < 2
                || choiceOk(request.resource.data.choices[1])
              )
              && (
                request.resource.data.choices.size() < 3
                || choiceOk(request.resource.data.choices[2])
              );
          }

          function askJobOk(jobId) {
            return jobId is string
              && jobId.size() <= 80
              && (
                jobId.size() == 0
                || emailLower() in get(/databases/$(database)/documents/organizations/$(orgId)/projects/$(jobId)).data.invitedEmails
              );
          }

          function askHistoryShapeOk() {
            return request.resource.data.keys().hasAll([
                'uid', 'orgId', 'jobId', 'jobLabel', 'question', 'askedAt', 'choices'
              ])
              && request.resource.data.keys().hasOnly([
                'uid', 'orgId', 'jobId', 'jobLabel', 'question', 'askedAt', 'choices'
              ])
              && request.resource.data.uid == historyUid
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.orgId == orgId
              && request.resource.data.jobLabel is string
              && request.resource.data.jobLabel.size() <= 120
              && request.resource.data.question is string
              && request.resource.data.question.size() > 0
              && request.resource.data.question.size() <= 500
              && request.resource.data.askedAt is timestamp
              && askJobOk(request.resource.data.jobId)
              && choicesOk();
          }

          allow read: if signedIn()
            && request.auth.uid == historyUid
            && resource.data.uid == request.auth.uid
            && isOrgInvited()
            && askJobOk(resource.data.jobId);
          allow create: if isOrgInvited()
            && request.auth.uid == historyUid
            && askHistoryShapeOk();
          allow update: if false;
          allow delete: if signedIn()
            && request.auth.uid == historyUid
            && resource.data.uid == request.auth.uid
            && isOrgInvited();
        }
      }

      // Phase 15 Part A. Receipts for assistant writes. Not a chat log.
      // Path: organizations/{orgId}/assistantReceipts/{receiptId}
      match /assistantReceipts/{receiptId} {
        function isOrgInvited() {
          return signedIn()
            && emailLower() in get(/databases/$(database)/documents/organizations/$(orgId)).data.invitedEmails;
        }

        function stringId(value, max) {
          return value is string && value.size() > 0 && value.size() <= max;
        }

        function fieldEvidenceOk(field) {
          return field.keys().hasOnly(['source', 'value'])
            && field.source in ['user', 'record', 'ocr', 'inferred']
            && (
              field.value == null
              || field.value is string
              || field.value is int
              || field.value is float
            );
        }

        function evidenceOk(e) {
          return e.keys().hasOnly([
              'tradeId', 'expenseId', 'receiptId', 'jobId',
              'date', 'amount', 'party', 'gst', 'batch'
            ])
            && (!e.keys().hasAny(['tradeId']) || fieldEvidenceOk(e.tradeId))
            && (!e.keys().hasAny(['expenseId']) || fieldEvidenceOk(e.expenseId))
            && (!e.keys().hasAny(['receiptId']) || fieldEvidenceOk(e.receiptId))
            && (!e.keys().hasAny(['jobId']) || fieldEvidenceOk(e.jobId))
            && (!e.keys().hasAny(['date']) || fieldEvidenceOk(e.date))
            && (!e.keys().hasAny(['amount']) || fieldEvidenceOk(e.amount))
            && (!e.keys().hasAny(['party']) || fieldEvidenceOk(e.party))
            && (!e.keys().hasAny(['gst']) || fieldEvidenceOk(e.gst))
            && (!e.keys().hasAny(['batch']) || fieldEvidenceOk(e.batch));
        }

        function stringIdList(value, maxItems, maxLen) {
          return value is list
            && value.size() <= maxItems
            && (value.size() == 0 || stringId(value[0], maxLen));
        }

        function documentIdsOk(d) {
          return d.keys().hasOnly(['expenseId', 'receiptId', 'expenseIds', 'receiptIds'])
            && (!d.keys().hasAny(['expenseId']) || stringId(d.expenseId, 128))
            && (!d.keys().hasAny(['receiptId']) || stringId(d.receiptId, 128))
            && (!d.keys().hasAny(['expenseIds']) || stringIdList(d.expenseIds, 80, 128))
            && (!d.keys().hasAny(['receiptIds']) || stringIdList(d.receiptIds, 80, 128));
        }

        function undoOk(u) {
          return u.kind in ['restoreTradeId', 'voidExpense', 'none', 'restoreTradeIdBatch']
            && (
              u.kind == 'restoreTradeIdBatch'
                ? (
                  u.keys().hasOnly(['kind', 'items'])
                  && u.items is list
                  && u.items.size() <= 80
                )
                : (
                  u.keys().hasOnly(['kind', 'expenseId', 'previousTradeId'])
                  && (!u.keys().hasAny(['expenseId']) || stringId(u.expenseId, 128))
                  && (
                    !u.keys().hasAny(['previousTradeId'])
                    || u.previousTradeId == null
                    || (u.previousTradeId is string && u.previousTradeId.size() <= 80)
                  )
                )
            );
        }

        function changedOk(c) {
          return c.keys().hasOnly(['tradeId'])
            && c.tradeId.keys().hasOnly(['from', 'to'])
            && (c.tradeId.from == null || (c.tradeId.from is string && c.tradeId.from.size() <= 80))
            && (c.tradeId.to == null || (c.tradeId.to is string && c.tradeId.to.size() <= 80));
        }

        function receiptShapeOk() {
          return request.resource.data.keys().hasAll([
              'id', 'orgId', 'jobId', 'action', 'source', 'clientKey',
              'tier', 'status', 'evidence', 'documentIds', 'undo', 'createdAt'
            ])
            && request.resource.data.keys().hasOnly([
              'id', 'orgId', 'jobId', 'action', 'source', 'clientKey',
              'tier', 'status', 'evidence', 'documentIds', 'undo', 'createdAt',
              'changed', 'undoneAt', 'undoReceiptId', 'origin'
            ])
            && request.resource.data.id == receiptId
            && request.resource.data.orgId == orgId
            && stringId(request.resource.data.jobId, 128)
            && request.resource.data.source == 'assistant'
            && request.resource.data.action in ['codeExpense', 'createExpense', 'codeExpenseBatch', 'undoAction']
            && request.resource.data.tier in ['do', 'propose', 'refuse']
            && request.resource.data.status in ['applied', 'proposed', 'refused', 'undone']
            && request.resource.data.clientKey is string
            && request.resource.data.clientKey.size() >= 8
            && request.resource.data.clientKey.size() <= 128
            && request.resource.data.createdAt is timestamp
            && evidenceOk(request.resource.data.evidence)
            && documentIdsOk(request.resource.data.documentIds)
            && undoOk(request.resource.data.undo)
            && (
              !request.resource.data.keys().hasAny(['changed'])
              || changedOk(request.resource.data.changed)
            )
            && (
              !request.resource.data.keys().hasAny(['undoneAt'])
              || request.resource.data.undoneAt is timestamp
            )
            && (
              !request.resource.data.keys().hasAny(['undoReceiptId'])
              || stringId(request.resource.data.undoReceiptId, 128)
            )
            && (
              !request.resource.data.keys().hasAny(['origin'])
              || request.resource.data.origin in ['human', 'assistant']
            )
            && !request.resource.data.keys().hasAny(['sentence', 'reason', 'messages', 'content', 'reply']);
        }

        allow read: if isOrgInvited();
        allow create: if isOrgInvited() && receiptShapeOk();
        allow update: if isOrgInvited()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'undoneAt', 'undoReceiptId'])
          && request.resource.data.status == 'undone'
          && resource.data.status in ['applied', 'proposed', 'refused', 'undone']
          && request.resource.data.clientKey == resource.data.clientKey
          && request.resource.data.action == resource.data.action
          && request.resource.data.orgId == resource.data.orgId
          && request.resource.data.jobId == resource.data.jobId
          && request.resource.data.evidence == resource.data.evidence
          && request.resource.data.documentIds == resource.data.documentIds
          && request.resource.data.source == 'assistant'
          && (
            !request.resource.data.keys().hasAny(['undoneAt'])
            || request.resource.data.undoneAt is timestamp
          )
          && (
            !request.resource.data.keys().hasAny(['undoReceiptId'])
            || stringId(request.resource.data.undoReceiptId, 128)
          );
        allow delete: if false;
      }

      match /{allPaths=**} {
        allow read, write: if false;
      }
    }

    // Private profile (mobile, ABN, business, address). Owner, or the same email on another uid.
    match /profiles/{uid} {
      function profileEmail() {
        return resource.data.email is string ? resource.data.email.lower() : '';
      }
      function signedInEmail() {
        return request.auth != null
          && request.auth.token.email is string
          && request.auth.token.email.size() > 0;
      }
      allow read: if request.auth != null && (
        request.auth.uid == uid
        || (signedInEmail() && request.auth.token.email.lower() == profileEmail())
      );
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // Name and photo only, keyed by lowercase email. Get if signed in; no listing.
    match /publicProfiles/{emailKey} {
      function publicProfileShape() {
        return request.resource.data.keys()
            .hasOnly(['uid', 'email', 'displayName', 'photoUrl', 'updatedAt', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email is string
          && request.resource.data.email == emailKey
          && request.auth.token.email is string
          && request.auth.token.email.lower() == request.resource.data.email;
      }
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null && publicProfileShape();
      allow delete: if false;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
