rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Leftover PIN copies. Keep the documents; do not leave them world-open.
    match /users/{accessCode} {
      allow read, write: if false;
      match /{allPaths=**} {
        allow read, write: if false;
      }
    }
    
    // Product-agnostic org + invite list (Phase 1 B).
    match /organizations/{orgId} {
      function signedIn() {
        return request.auth != null
          && request.auth.token.email is string
          && request.auth.token.email.size() > 0;
      }

      function emailLower() {
        return request.auth.token.email.lower();
      }

      function isInvited() {
        return signedIn() && emailLower() in resource.data.invitedEmails;
      }

      allow read: if isInvited();
      allow create, delete: if false;
      allow update: if isInvited()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['legacyWorkspaceNames', 'invitedEmails', 'updatedAt'])
        && request.resource.data.ownerEmail.lower() in request.resource.data.invitedEmails
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['invitedEmails'])
          || emailLower() == resource.data.ownerEmail.lower()
        );

      match /projects/{projectId} {
        function orgDoc() {
          return get(/databases/$(database)/documents/organizations/$(orgId));
        }

        function isOrgOwner() {
          return signedIn() && emailLower() == orgDoc().data.ownerEmail.lower();
        }

        function isProjectMember() {
          return signedIn() && emailLower() in resource.data.invitedEmails;
        }

        function canUseProject() {
          return signedIn()
            && emailLower() in get(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)).data.invitedEmails;
        }

        function ownerStaysOnJob() {
          return orgDoc().data.ownerEmail.lower() in request.resource.data.invitedEmails;
        }

        function statusOk() {
          return !request.resource.data.keys().hasAny(['status'])
            || request.resource.data.status in ['active', 'archived'];
        }

        allow read: if isProjectMember();
        allow create: if isOrgOwner()
          && request.resource.data.orgId == orgId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.status == 'active'
          && request.resource.data.invitedEmails is list
          && emailLower() in request.resource.data.invitedEmails
          && orgDoc().data.ownerEmail.lower() in request.resource.data.invitedEmails
          && !request.resource.data.keys().hasAny(['legacyWorkspaceId', 'accessCode']);
        allow update: if isProjectMember()
          && ownerStaysOnJob()
          && statusOk()
          && (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'updatedAt'])
            || (
              isOrgOwner()
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['name', 'invitedEmails', 'formerEmails', 'status', 'archivedAt', 'archivedBy', 'updatedAt'])
            )
          );
        allow delete: if false;

        match /{allPaths=**} {
          allow read, write: if canUseProject();
        }
      }

      match /{allPaths=**} {
        allow read, write: if false;
      }
    }

    // Signed-in user profiles (name, company, photo). Own write, any signed-in read.
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
