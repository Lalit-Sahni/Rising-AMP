rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to access their own data (temporarily allow all access for debugging)
    match /users/{accessCode} {
      allow read, write: if true;
      
      // Allow access to all subcollections with specific rules for new unified structure
      match /expenses/{document} {
        allow read, write: if true;
      }
      match /clients/{document} {
        allow read, write: if true;
      }
      match /labour/{document} {
        allow read, write: if true;
      }
      match /trades/{document} {
        allow read, write: if true;
      }
      match /projects/{document} {
        allow read, write: if true;
      }
      match /purchaseOrders/{document} {
        allow read, write: if true;
      }
      match /workerHistory/{document} {
        allow read, write: if true;
      }
      match /siteNames/{document} {
        allow read, write: if true;
      }
      match /projectPhases/{document} {
        allow read, write: if true;
      }
      match /progressPayments/{document} {
        allow read, write: if true;
      }
      match /invoices/{document} {
        allow read, write: if true;
      }
      match /hiaContracts/{document} {
        allow read, write: if true;
      }
      match /bankDetails/{document} {
        allow read, write: if true;
      }
      // Legacy collections for backward compatibility
      match /savedLabour/{document} {
        allow read, write: if true;
      }
      match /savedTrades/{document} {
        allow read, write: if true;
      }
      match /savedCompanies/{document} {
        allow read, write: if true;
      }
      match /savedProjects/{document} {
        allow read, write: if true;
      }
      match /clientDetails/{document} {
        allow read, write: if true;
      }
      // Catch-all for any other subcollections
      match /{allPaths=**} {
        allow read, write: if true;
      }
    }
    
    // Product-agnostic org + invite list (Phase 1 B).
    match /organizations/{orgId} {
      function signedIn() {
        return request.auth != null
          && request.auth.token.email is string
          && request.auth.token.email.size() > 0;
      }

      function emailLower() {
        return request.auth.token.email.lower();
      }

      function isInvited() {
        return signedIn() && emailLower() in resource.data.invitedEmails;
      }

      allow read: if isInvited();
      allow create, delete: if false;
      allow update: if isInvited()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['legacyWorkspaceNames', 'invitedEmails', 'updatedAt'])
        && request.resource.data.ownerEmail.lower() in request.resource.data.invitedEmails
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['invitedEmails'])
          || emailLower() == resource.data.ownerEmail.lower()
        );

      match /projects/{projectId} {
        function isProjectMember() {
          return signedIn() && emailLower() in resource.data.invitedEmails;
        }

        function canUseProject() {
          return signedIn()
            && emailLower() in get(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)).data.invitedEmails;
        }

        allow read: if isProjectMember();
        allow update: if isProjectMember()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'invitedEmails', 'updatedAt'])
          && get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerEmail.lower()
            in request.resource.data.invitedEmails;
        allow create, delete: if false;

        match /{allPaths=**} {
          allow read, write: if canUseProject();
        }
      }

      match /{allPaths=**} {
        allow read, write: if false;
      }
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
