rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Leftover PIN copies. Keep the documents; do not leave them world-open.
    match /users/{accessCode} {
      allow read, write: if false;
      match /{allPaths=**} {
        allow read, write: if false;
      }
    }
    
    // Product-agnostic org + invite list (Phase 1 B).
    match /organizations/{orgId} {
      function signedIn() {
        return request.auth != null
          && request.auth.token.email is string
          && request.auth.token.email.size() > 0;
      }

      function emailLower() {
        return request.auth.token.email.lower();
      }

      function isInvited() {
        return signedIn() && emailLower() in resource.data.invitedEmails;
      }

      allow read: if isInvited();
      allow create, delete: if false;
      allow update: if isInvited()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['legacyWorkspaceNames', 'invitedEmails', 'updatedAt'])
        && request.resource.data.ownerEmail.lower() in request.resource.data.invitedEmails
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['invitedEmails'])
          || emailLower() == resource.data.ownerEmail.lower()
        );

      match /projects/{projectId} {
        function orgDoc() {
          return get(/databases/$(database)/documents/organizations/$(orgId));
        }

        function isOrgOwner() {
          return signedIn() && emailLower() == orgDoc().data.ownerEmail.lower();
        }

        function isProjectMember() {
          return signedIn() && emailLower() in resource.data.invitedEmails;
        }

        function canUseProject() {
          return signedIn()
            && emailLower() in get(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)).data.invitedEmails;
        }

        function ownerStaysOnJob() {
          return orgDoc().data.ownerEmail.lower() in request.resource.data.invitedEmails;
        }

        function statusOk() {
          return !request.resource.data.keys().hasAny(['status'])
            || request.resource.data.status in ['active', 'archived'];
        }

        allow read: if isProjectMember();
        allow create: if isOrgOwner()
          && request.resource.data.orgId == orgId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.status == 'active'
          && request.resource.data.invitedEmails is list
          && emailLower() in request.resource.data.invitedEmails
          && orgDoc().data.ownerEmail.lower() in request.resource.data.invitedEmails
          && !request.resource.data.keys().hasAny(['legacyWorkspaceId', 'accessCode']);
        allow update: if isProjectMember()
          && ownerStaysOnJob()
          && statusOk()
          && (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'updatedAt', 'budget'])
            || (
              isOrgOwner()
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['name', 'invitedEmails', 'formerEmails', 'status', 'archivedAt', 'archivedBy', 'updatedAt', 'budget'])
            )
          );
        allow delete: if false;

        function expenseOk() {
          return !request.resource.data.keys().hasAny(['category'])
            || request.resource.data.category is string;
        }

        function invoiceOk() {
          return request.resource.data.invoiceNumber is string
            && (
              !request.resource.data.keys().hasAny(['status'])
              || request.resource.data.status in ['draft', 'sent', 'paid', 'overdue', 'void', 'pending', 'unpaid']
            );
        }

        match /expenses/{itemId} {
          allow read: if canUseProject();
          allow create, update: if canUseProject() && expenseOk();
          allow delete: if canUseProject()
            && resource.data.keys().hasAny(['status'])
            && resource.data.status == 'void';
        }
        match /invoices/{itemId} {
          allow read: if canUseProject();
          allow create, update: if canUseProject() && invoiceOk();
          allow delete: if canUseProject()
            && resource.data.keys().hasAny(['status'])
            && resource.data.status == 'void';
        }
        match /hiaContracts/{itemId} {
          allow read: if canUseProject();
          allow create, update: if canUseProject();
          allow delete: if false;
        }
        match /progressPayments/{itemId} {
          allow read: if canUseProject();
          allow create, update: if canUseProject();
          allow delete: if false;
        }
        match /labour/{itemId} {
          allow read: if canUseProject();
          allow create, update: if canUseProject();
          allow delete: if false;
        }
        match /trades/{itemId} {
          allow read: if canUseProject();
          allow create, update: if canUseProject();
          allow delete: if false;
        }
        match /clients/{itemId} {
          allow read: if canUseProject();
          allow create, update: if canUseProject();
          allow delete: if false;
        }
        match /suppliers/{itemId} {
          allow read: if canUseProject();
          allow create, update: if canUseProject();
          allow delete: if false;
        }
        match /serviceProviders/{itemId} {
          allow read: if canUseProject();
          allow create, update: if canUseProject();
          allow delete: if false;
        }
        match /payers/{itemId} {
          allow read: if canUseProject();
          allow create, update: if canUseProject();
          allow delete: if false;
        }
        match /bankDetails/{itemId} {
          allow read: if canUseProject();
          allow create, update: if canUseProject();
          allow delete: if false;
        }
        match /costPlan/{planId} {
          function costPlanOk() {
            return planId == 'current'
              && request.resource.data.keys().hasOnly([
                'jobId', 'level', 'targetCents', 'baselineDate', 'gstMode',
                'status', 'sections', 'createdBy', 'createdAt', 'updatedAt',
                'archivedAt'
              ])
              && request.resource.data.keys().hasAll([
                'jobId', 'level', 'targetCents', 'baselineDate', 'gstMode',
                'status', 'sections', 'createdBy', 'createdAt', 'updatedAt',
                'archivedAt'
              ])
              && request.resource.data.jobId == projectId
              && request.resource.data.level == 'target'
              && request.resource.data.targetCents is int
              && request.resource.data.targetCents > 0
              && request.resource.data.baselineDate is string
              && request.resource.data.baselineDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
              && request.resource.data.gstMode in ['inclusive', 'exclusive']
              && request.resource.data.status in ['draft', 'locked', 'archived']
              && request.resource.data.sections is list
              && request.resource.data.sections.size() == 0
              && request.resource.data.createdBy is string
              && request.resource.data.createdBy.size() > 0
              && request.resource.data.createdAt is timestamp
              && request.resource.data.updatedAt is timestamp
              && (
                (request.resource.data.status == 'archived'
                  && request.resource.data.archivedAt is timestamp)
                || (request.resource.data.status != 'archived'
                  && request.resource.data.archivedAt == null)
              );
          }

          allow read: if canUseProject();
          allow create: if canUseProject()
            && costPlanOk()
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.status == 'draft';
          allow update: if canUseProject()
            && costPlanOk()
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.jobId == resource.data.jobId
            && resource.data.status == 'draft'
            && request.resource.data.status == 'draft'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['targetCents', 'baselineDate', 'gstMode', 'updatedAt']);
          allow delete: if false;
        }
        match /files/{itemId} {
          function jobFileTypeOk() {
            return request.resource.data.type in [
              'contract', 'variation', 'plan', 'permit', 'certificate',
              'quote', 'photo', 'invoiceReceived', 'other'
            ];
          }

          function jobFileContentTypeOk() {
            return request.resource.data.contentType is string
              && !request.resource.data.contentType.matches('^video/.*')
              && request.resource.data.contentType in [
                'image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp',
                'image/heic', 'image/heif', 'image/tiff',
                'application/pdf',
                'application/msword',
                'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
                'application/vnd.ms-excel',
                'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
                'application/vnd.ms-powerpoint',
                'application/vnd.openxmlformats-officedocument.presentationml.presentation',
                'text/plain',
                'application/rtf',
                'application/acad',
                'image/vnd.dwg',
                'application/dxf',
                'application/x-dxf'
              ];
          }

          function jobFileLinkedToOk() {
            return !request.resource.data.keys().hasAny(['linkedTo'])
              || request.resource.data.linkedTo == null
              || (
                request.resource.data.linkedTo.keys().hasAll(['kind', 'id'])
                && request.resource.data.linkedTo.kind in ['expense', 'invoice', 'hiaContract']
                && request.resource.data.linkedTo.id is string
                && request.resource.data.linkedTo.id.size() > 0
              );
          }

          function jobFilePathOk() {
            return request.resource.data.storagePath is string
              && request.resource.data.storagePath.matches(
                '^files/' + orgId + '/' + projectId + '/' + itemId + '/.+'
              )
              && (
                !request.resource.data.keys().hasAny(['thumbnailPath'])
                || request.resource.data.thumbnailPath == null
                || (
                  request.resource.data.thumbnailPath is string
                  && request.resource.data.thumbnailPath.matches(
                    '^files/' + orgId + '/' + projectId + '/' + itemId + '/.+'
                  )
                )
              );
          }

          function jobFileOk() {
            return request.resource.data.name is string
              && request.resource.data.name.size() > 0
              && request.resource.data.name.size() <= 200
              && jobFileTypeOk()
              && jobFilePathOk()
              && jobFileContentTypeOk()
              && request.resource.data.sizeBytes is number
              && request.resource.data.sizeBytes >= 0
              && request.resource.data.sizeBytes <= 26214400
              && request.resource.data.uploadedBy is string
              && request.resource.data.uploadedBy.size() > 0
              && request.resource.data.documentDate is string
              && request.resource.data.documentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
              && (
                !request.resource.data.keys().hasAny(['note'])
                || request.resource.data.note is string
              )
              && request.resource.data.status in ['active', 'archived']
              && (
                request.resource.data.status == 'active'
                || request.resource.data.archivedAt is timestamp
              )
              && jobFileLinkedToOk();
          }

          allow read: if canUseProject();
          allow create: if canUseProject()
            && jobFileOk()
            && request.resource.data.uploadedBy == request.auth.uid
            && request.resource.data.status == 'active';
          allow update: if canUseProject()
            && jobFileOk()
            && request.resource.data.uploadedBy == resource.data.uploadedBy
            && request.resource.data.storagePath == resource.data.storagePath;
          allow delete: if false;
        }
        match /{allPaths=**} {
          allow read, write: if false;
        }
      }

      match /{allPaths=**} {
        allow read, write: if false;
      }
    }

    // Private profile (mobile, ABN, business, address). Owner, or the same email on another uid.
    match /profiles/{uid} {
      function profileEmail() {
        return resource.data.email is string ? resource.data.email.lower() : '';
      }
      function signedInEmail() {
        return request.auth != null
          && request.auth.token.email is string
          && request.auth.token.email.size() > 0;
      }
      allow read: if request.auth != null && (
        request.auth.uid == uid
        || (signedInEmail() && request.auth.token.email.lower() == profileEmail())
      );
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // Name and photo only, keyed by lowercase email. Get if signed in; no listing.
    match /publicProfiles/{emailKey} {
      function publicProfileShape() {
        return request.resource.data.keys()
            .hasOnly(['uid', 'email', 'displayName', 'photoUrl', 'updatedAt', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email is string
          && request.resource.data.email == emailKey
          && request.auth.token.email is string
          && request.auth.token.email.lower() == request.resource.data.email;
      }
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null && publicProfileShape();
      allow delete: if false;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
