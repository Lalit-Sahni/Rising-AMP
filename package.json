{
  "name": "risingamp",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@types/react-datepicker": "^6.2.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-datepicker": "^8.4.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.8",
    "react-scripts": "^5.0.1",
    "react-select": "^5.10.2",
    "recharts": "^3.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "autoprefixer": "^10.4.14",
    "cssnano": "^7.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.3.3"
  },
  "scripts": {
    "start": "react-scripts start",
    "start:clean": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true; react-scripts start",
    "dev": "PORT=3001 react-scripts start",
    "build": "react-scripts build",
    "build:analyze": "ANALYZE=true react-scripts build",
    "analyze": "node scripts/analyze-bundle.js",
    "test": "react-scripts test",
    "test:rules": "sh scripts/run-rules-tests.sh",
    "eject": "react-scripts eject",
    "backup": "node scripts/backup-firebase-data.js",
    "backup:production": "node scripts/backup-production.js",
    "restore": "node scripts/restore-firebase-data.js",
    "restore:staging": "node scripts/restore-to-staging.js",
    "security:audit": "npm audit",
    "security:audit:fix": "npm audit fix",
    "security:check": "npm audit --audit-level moderate",
    "deps:check": "npm outdated",
    "deps:update": "npm update",
    "deps:security": "npm audit --audit-level high",
    "env:check": "node -e \"console.log('Environment check:'); console.log('NODE_ENV:', process.env.NODE_ENV); console.log('REACT_APP_FIREBASE_API_KEY:', process.env.REACT_APP_FIREBASE_API_KEY ? 'Set' : 'Missing');\"",
    "precommit": "npm run security:check && npm run build",
    "postinstall": "npm run security:audit"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
