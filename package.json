{
  "name": "risingamp",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@types/react-datepicker": "^6.2.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.263.1",
    "pdf-lib": "^1.17.1",
    "react": "^18.2.0",
    "react-datepicker": "^8.4.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.8",
    "react-router-dom": "^7.18.2",
    "react-select": "^5.10.2",
    "recharts": "^3.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.14",
    "cssnano": "^7.1.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^6.0.3",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "start": "vite",
    "start:clean": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true; vite",
    "dev": "vite --port 3001",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "preview": "vite preview",
    "preview:staging": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true; vite build --mode staging && vite preview --port 3000 --strictPort",
    "build:analyze": "vite build",
    "analyze": "node scripts/analyze-bundle.js",
    "test": "vitest run && node --test functions/lib/emailMatch.test.js functions/lib/estimateCheck.test.js functions/lib/quoteRead.test.js functions/lib/ledgerRollup.test.js functions/lib/maintainLedgerRollup.test.js",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:rules": "sh scripts/run-rules-tests.sh",
    "backfill:public-profiles": "node scripts/backfill-public-profiles.js",
    "backup": "node scripts/backup-firebase-data.js",
    "backup:production": "node scripts/backup-production.js",
    "restore": "node scripts/restore-firebase-data.js",
    "restore:staging": "node scripts/restore-to-staging.js",
    "security:audit": "npm audit",
    "security:audit:fix": "npm audit fix",
    "security:check": "npm audit --audit-level moderate",
    "deps:check": "npm outdated",
    "deps:update": "npm update",
    "deps:security": "npm audit --audit-level high",
    "env:check": "node -e \"console.log('Environment check:'); console.log('VITE_FIREBASE_PROJECT_ID is in .env.local (staging) and .env.production.local (production). Do not print secrets.');\"",
    "precommit": "npm run security:check && npm run build",
    "postinstall": "npm run security:audit"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
