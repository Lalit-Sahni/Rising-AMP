rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.size() > 0;
    }

    function emailLower() {
      return request.auth.token.email.lower();
    }

    // Fallback for receipt objects uploaded before Phase 9, which have no
    // orgId in metadata. New uploads send orgId; new job-file paths will
    // carry orgId in the path (Part B). Do not copy this into those paths.
    function familyOrgId() {
      return 'opal-ss-constructions';
    }

    function orgPath(orgId) {
      return /databases/(default)/documents/organizations/$(orgId);
    }

    function jobPath(orgId, jobId) {
      return /databases/(default)/documents/organizations/$(orgId)/projects/$(jobId);
    }

    function isJobMember(orgId, jobId) {
      return firestore.exists(jobPath(orgId, jobId))
        && emailLower() in firestore.get(jobPath(orgId, jobId)).data.invitedEmails;
    }

    function isLegacyWorkspaceFolder(orgId, folder) {
      return firestore.exists(orgPath(orgId))
        && 'legacyWorkspaceIds' in firestore.get(orgPath(orgId)).data
        && folder in firestore.get(orgPath(orgId)).data.legacyWorkspaceIds;
    }

    function canUseFolder(orgId, folder) {
      return isJobMember(orgId, folder) || isLegacyWorkspaceFolder(orgId, folder);
    }

    function orgIdFromMeta(meta) {
      return meta.keys().hasAny(['orgId'])
        && meta.orgId is string
        && meta.orgId.size() > 0
          ? meta.orgId
          : familyOrgId();
    }

    function canReadReceiptFolder(folder) {
      return signedIn() && canUseFolder(orgIdFromMeta(resource.metadata), folder);
    }

    function canWriteReceiptFolder(folder) {
      return signedIn() && canUseFolder(orgIdFromMeta(request.resource.metadata), folder);
    }

    match /receipts/{folder}/{expenseId}/{fileName} {
      allow read: if canReadReceiptFolder(folder);
      allow write: if canWriteReceiptFolder(folder);
    }

    match /avatars/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
