# Firebase Configuration
# Copy to .env.local (staging) or .env.production.local (production).
# Localhost must stay on staging (rising-amp-staging). Do not swap the files.

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Optional. App Check with reCAPTCHA Enterprise. Leave empty until the site key
# is created in Firebase Console (staging first). Do not turn on enforcement
# until the console shows clean traffic. Debug tokens are used on localhost.
# VITE_FIREBASE_APPCHECK_SITE_KEY=

# Google Cloud Vision API (OCR fallback only; key is visible in the browser bundle)
# VITE_GOOGLE_CLOUD_VISION_API_KEY=

# OpenAI is NOT a VITE_ variable. The browser cannot call api.openai.com (CORS),
# and the key must not ship in the client. Set Firebase secret OPENAI_API_KEY, then
# deploy functions:readReceiptImage by name. Owner sets the secret at a masked prompt.

# Node scripts (backup/restore) may still read REACT_APP_* from the same files.
# Keep both prefixes in the gitignored env files until those scripts are updated.
